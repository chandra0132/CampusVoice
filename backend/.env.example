# Gnani AI API Credentials
# Get your API key from https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# Model Configurations
# PRISMA STT Model Name / ID
PRISMA_MODEL=prisma-v3.0

# TIMBRE TTS Model Name / Voice ID
TIMBRE_MODEL=timbre-v2.5

# Voice Names (Optional overrides)
VOICE_TELUGU=Suhana
VOICE_HINDI=Nalini
VOICE_ENGLISH=Kaveri

# Network & Timeout Configuration
GNANI_TIMEOUT=30.0

# Production CORS & Server Configuration
FRONTEND_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
PORT=8000
HOST=0.0.0.0
